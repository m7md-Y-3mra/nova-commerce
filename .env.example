# Copy to .env and replace every placeholder before running `docker compose up`.
# .env is git-ignored. Never commit real credentials.

# Host port the store is served on (http://localhost:<WP_PORT>)
WP_PORT=8090
WP_URL=http://localhost:8090

# Database (internal to the compose network, not published to the host)
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=change-me-db-password
DB_ROOT_PASSWORD=change-me-root-password

# WordPress admin created by bin/setup.sh
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=change-me-admin-password
WP_ADMIN_EMAIL=admin@example.test
